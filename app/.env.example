# Copy to .env (never commit .env).
# Generate a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
PORT=3000
BASE_URL=http://localhost:3000
# DATABASE_FILE=./data/app.db
# NODE_ENV=production   # turns on Secure cookies and hides /api/dev/outbox

# --- AI replies (optional). Without a key, agents run in FAQ-only mode. ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini          # any chat model your account has; check platform.openai.com/docs/models
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible provider works

# --- Telegram ---
# Leave PUBLIC_URL empty on your PC: the server polls Telegram, no public address needed.
# On a server with HTTPS, set it so Telegram pushes messages instantly via webhooks:
# PUBLIC_URL=https://your-domain.com

# --- Instagram (Instagram API with Instagram Login) ---
# Needs PUBLIC_URL on HTTPS (Meta must reach your webhooks). Use the *Instagram* app ID/secret
# from App Dashboard → Instagram → API setup with Instagram login (not the Meta app ID).
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_VERIFY_TOKEN=          # any long random string; paste the same value in the Meta webhook settings
# INSTAGRAM_GRAPH_VERSION=v26.0
