# Copy to .env for local runs. On Render set these as Environment Variables.
BOT_TOKEN=123456:ABC...           # from @BotFather
ADMIN_ID=123456789                # your numeric Telegram id (@userinfobot)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
INVITE_CODE=KURS-XXXXXX           # one-time code for the student
WEBHOOK_SECRET=random-long-string # Telegram -> bot webhook secret
TICK_SECRET=random-long-string    # protects /tick
TEST_MODE=0                       # 1 = admin can take the course as a test learner
# PUBLIC_URL=https://...          # optional; Render sets RENDER_EXTERNAL_URL automatically
